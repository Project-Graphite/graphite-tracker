generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaCategory {
  MOVIE  @map("movie")
  TV     @map("tv")
  ANIME  @map("anime")
  MANGA  @map("manga")
  MANHWA @map("manhwa")
  GAME   @map("game")
}

enum LibraryState {
  PLANNED     @map("planned")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  DROPPED     @map("dropped")
}

enum ReviewVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

enum ReportReason {
  SPAM     @map("spam")
  ABUSE    @map("abuse")
  SPOILERS @map("spoilers")
  OTHER    @map("other")
}

enum ReportResolution {
  DISMISSED @map("dismissed")
  HIDDEN    @map("hidden")
}

enum ActivityKind {
  ADDED         @map("added")
  STATE_CHANGED @map("state_changed")
  RATED         @map("rated")
  REVIEWED      @map("reviewed")
}

enum ImportState {
  PARSING  @map("parsing")
  MATCHING @map("matching")
  READY    @map("ready")
  APPLYING @map("applying")
  APPLIED  @map("applied")
  FAILED   @map("failed")
}

enum ImportConflictPolicy {
  ADD_MISSING           @map("add_missing")
  KEEP_GREATER_PROGRESS @map("keep_greater_progress")
}

enum ImportMatch {
  PENDING     @map("pending")
  EXACT       @map("exact")
  SUGGESTED   @map("suggested")
  UNMATCHED   @map("unmatched")
  DUPLICATE   @map("duplicate")
  UNSUPPORTED @map("unsupported")
}

enum ImportDecision {
  ACCEPT @map("accept")
  SKIP   @map("skip")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  handle             String              @unique
  displayName        String              @map("display_name")
  passwordHash       String              @map("password_hash")
  bio                 String?
  verifiedAt         DateTime?           @map("verified_at")
  timeZone            String              @default("Etc/UTC") @map("time_zone")
  isActive            Boolean             @default(true) @map("is_active")
  isAdmin             Boolean             @default(false) @map("is_admin")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  privacy             ProfilePrivacy?
  verificationTokens VerificationToken[]
  refreshSessions    RefreshSession[]
  libraryEntries     LibraryEntry[]
  globalSourcePreference GlobalSourcePreference?
  categorySourcePreferences CategorySourcePreference[]
  sourceSettings UserSourceSetting[]
  importBatches  ImportBatch[]
  reviews         Review[]
  reportsFiled    ReviewReport[]  @relation("ReportsFiled")
  reportsResolved ReviewReport[]  @relation("ReportsResolved")
  activity        ActivityEvent[]

  @@map("users")
}

model ProfilePrivacy {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  isPublic       Boolean @default(false) @map("is_public")
  showLibrary    Boolean @default(false) @map("show_library")
  showActivity   Boolean @default(false) @map("show_activity")
  showRatings    Boolean @default(false) @map("show_ratings")
  showReviews    Boolean @default(false) @map("show_reviews")
  showStatistics Boolean @default(false) @map("show_statistics")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_privacy")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model CatalogItem {
  id              String         @id @default(uuid()) @db.Uuid
  category        MediaCategory
  canonicalTitle  String         @map("canonical_title")
  alternateTitles String[]       @default([]) @map("alternate_titles")
  synopsis        String?
  posterPath      String?        @map("poster_path")
  backdropPath    String?        @map("backdrop_path")
  releaseDate     DateTime?      @map("release_date") @db.Date
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sourceEntries   SourceEntry[]
  libraryEntries  LibraryEntry[]
  reviews         Review[]
  activity        ActivityEvent[]

  @@index([category, canonicalTitle])
  @@map("catalog_items")
}

model SourceRecord {
  id            String          @id @default(uuid()) @db.Uuid
  key           String          @unique
  displayName   String          @map("display_name")
  categories    MediaCategory[] @default([])
  languages     String[]        @default([])
  capabilities  String[]        @default([])
  attribution   String
  enabled       Boolean         @default(true)
  sourceEntries SourceEntry[]
  preferredByEntries LibraryEntry[] @relation("PreferredSource")
  globalPreferences GlobalSourcePreference[]
  categoryPreferences CategorySourcePreference[]
  userSettings UserSourceSetting[]

  @@map("source_records")
}

model SourceEntry {
  id              String       @id @default(uuid()) @db.Uuid
  catalogItemId   String       @map("catalog_item_id") @db.Uuid
  sourceId        String       @map("source_id") @db.Uuid
  externalId      String       @map("external_id")
  canonicalUrl    String?      @map("canonical_url")
  language        String?
  sourceTitle     String       @map("source_title")
  lastRefreshedAt DateTime?    @map("last_refreshed_at")
  availableChapter Decimal?    @map("available_chapter") @db.Decimal(10, 2)
  availableEpisode Int?        @map("available_episode")
  lastSeenUpdate   String?     @map("last_seen_update")
  catalogItem     CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  source          SourceRecord @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([catalogItemId])
  @@map("source_entries")
}

model LibraryEntry {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  catalogItemId        String               @map("catalog_item_id") @db.Uuid
  state                LibraryState         @default(PLANNED)
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  notificationsEnabled Boolean              @default(false) @map("notifications_enabled")
  progressSeason      Int?                  @map("progress_season")
  progressEpisode     Int?                  @map("progress_episode")
  progressChapter     Decimal?              @map("progress_chapter") @db.Decimal(10, 2)
  progressVolume      Decimal?              @map("progress_volume") @db.Decimal(10, 2)
  hoursPlayed         Decimal?              @map("hours_played") @db.Decimal(10, 2)
  completionPercentage Int?                 @map("completion_percentage")
  platforms           String[]              @default([])
  preferredSourceId   String?               @map("preferred_source_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem          CatalogItem          @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  preferredSource      SourceRecord?        @relation("PreferredSource", fields: [preferredSourceId], references: [id], onDelete: SetNull)
  statusEvents         LibraryStatusEvent[]
  importedSources      ImportedSourceReference[]
  activity             ActivityEvent[]

  @@unique([userId, catalogItemId])
  @@index([userId, state])
  @@map("library_entries")
}

model GlobalSourcePreference {
  userId    String       @id @map("user_id") @db.Uuid
  sourceId  String       @map("source_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    SourceRecord @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@map("global_source_preferences")
}

model CategorySourcePreference {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  category  MediaCategory
  sourceId  String        @map("source_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    SourceRecord  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([userId, category])
  @@map("category_source_preferences")
}

model UserSourceSetting {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  sourceId String       @map("source_id") @db.Uuid
  enabled  Boolean      @default(true)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   SourceRecord @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@map("user_source_settings")
}

model LibraryStatusEvent {
  id             String        @id @default(uuid()) @db.Uuid
  libraryEntryId String        @map("library_entry_id") @db.Uuid
  oldState       LibraryState? @map("old_state")
  newState       LibraryState  @map("new_state")
  createdAt      DateTime      @default(now()) @map("created_at")
  libraryEntry   LibraryEntry  @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@index([libraryEntryId, createdAt])
  @@map("library_status_events")
}

model ImportBatch {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  sourceApp        String?                   @map("source_app")
  fileDigest       String                    @map("file_digest")
  state            ImportState               @default(PARSING)
  conflictPolicy   ImportConflictPolicy      @default(ADD_MISSING) @map("conflict_policy")
  error            String?
  expiresAt        DateTime                  @map("expires_at")
  appliedAt        DateTime?                 @map("applied_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates       ImportCandidate[]
  sourceReferences ImportedSourceReference[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("import_batches")
}

model ImportCandidate {
  id            String          @id @default(uuid()) @db.Uuid
  batchId       String          @map("batch_id") @db.Uuid
  position      Int
  kind          String
  title         String
  trackerTitles String[]        @default([]) @map("tracker_titles")
  sourceName    String?         @map("source_name")
  sourceUrl     String?         @map("source_url")
  mangadexId    String?         @map("mangadex_id")
  progress      Decimal?        @db.Decimal(10, 2)
  state         LibraryState
  match         ImportMatch     @default(PENDING)
  issue         String?
  options       Json            @default("[]")
  choice        Int?
  decision      ImportDecision?
  outcome       String?
  catalogItemId String?         @map("catalog_item_id") @db.Uuid
  batch         ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, position])
  @@index([batchId, match])
  @@map("import_candidates")
}

model ImportedSourceReference {
  id             String       @id @default(uuid()) @db.Uuid
  libraryEntryId String       @map("library_entry_id") @db.Uuid
  batchId        String?      @map("batch_id") @db.Uuid
  sourceName     String       @map("source_name")
  sourceUrl      String       @map("source_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  batch          ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([libraryEntryId, sourceName, sourceUrl])
  @@map("imported_source_references")
}

model Review {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  catalogItemId    String           @map("catalog_item_id") @db.Uuid
  rating           Int?
  title            String?
  body             String?
  containsSpoilers Boolean          @default(false) @map("contains_spoilers")
  visibility       ReviewVisibility @default(PRIVATE)
  hiddenAt         DateTime?        @map("hidden_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem      CatalogItem      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  reports          ReviewReport[]
  activity         ActivityEvent[]

  @@unique([userId, catalogItemId])
  @@index([catalogItemId, visibility])
  @@map("reviews")
}

model ReviewReport {
  id          String            @id @default(uuid()) @db.Uuid
  reviewId    String            @map("review_id") @db.Uuid
  reporterId  String            @map("reporter_id") @db.Uuid
  reason      ReportReason
  resolution  ReportResolution?
  moderatorId String?           @map("moderator_id") @db.Uuid
  resolvedAt  DateTime?         @map("resolved_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  review      Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter    User              @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User?             @relation("ReportsResolved", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([reporterId, reviewId])
  @@index([resolution, createdAt])
  @@map("review_reports")
}

model ActivityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  kind           ActivityKind
  catalogItemId  String        @map("catalog_item_id") @db.Uuid
  libraryEntryId String?       @map("library_entry_id") @db.Uuid
  reviewId       String?       @map("review_id") @db.Uuid
  state          LibraryState?
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  libraryEntry   LibraryEntry? @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  review         Review?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_events")
}
